# Settings for the pinned Athena speech image; keep HA credentials private.
WYO_WHISPER_MODEL=base-int8
WYO_WHISPER_LANGUAGE=en
WYO_WHISPER_CPU_THREADS=4
WYO_WHISPER_COMPUTE_TYPE=int8
WYO_WHISPER_BEAM_SIZE=3
ATHENA_WHISPER_SINGLE_PASS=true
# Enable offline mode after the model weights and fallback tokenizer are cached.
HF_HUB_CACHE=/data/huggingface-hub
HF_HUB_OFFLINE=1
