{
  "servers": [
    {"name": "ha", "url": "http://homeassistant.local:8123/api/mcp", "token_env": "ATHENA_HA_MCP_TOKEN"},
    {"name": "windows", "url": "http://windows-pc:8000/mcp", "token_env": "ATHENA_WINDOWS_MCP_TOKEN"}
  ],
  "model_timeout": 60,
