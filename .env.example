# Complete Chat Completions endpoint URL; HTTPS required except local fake tests.
ATHENA_MODEL_API_URL=https://your-provider.example/v1/chat/completions
ATHENA_MODEL=your-tool-capable-cloud-model
ATHENA_MODEL_API_KEY=replace-locally
ATHENA_HA_MCP_TOKEN=replace-locally
ATHENA_WINDOWS_MCP_TOKEN=replace-locally
# Opt-in local routing for registered HA light actions and 2–3 known clauses.
# Mixed contextual requests retain the cloud path. Local and contextual HA
# requests share the ha MCP endpoint/token; local commands need no model key.
ATHENA_LOCAL_HA_ENABLED=false
# Separate opt-in for registered Notepad launches through Windows MCP, no LLM.
ATHENA_LOCAL_APPS_ENABLED=false
ATHENA_NOTEPAD_EXECUTABLE=C:\Windows\System32\notepad.exe
# Optional content-free JSON diagnostics on stderr/journal; no transcript logging.
ATHENA_ROUTE_LOG=false
# Optional Pi-native wake tool. A dispatched packet does not confirm PC startup.
PC_MAC_ADDRESS=
WOL_BROADCAST_ADDRESS=255.255.255.255
# Existing local audio/transcription settings remain independent of the agent.
WHISPER_URI=tcp://127.0.0.1:10300
# Log STT duration and original audio levels without saving recordings.
ATHENA_STT_DIAGNOSTICS=false
# Custom local wake detector; these are ONNX assets, separate from the cloud model.
ATHENA_WAKE_ENGINE=custom
ATHENA_WAKE_MODEL=/path/to/hey_athena.onnx
ATHENA_WAKE_MELSPEC_MODEL=/path/to/melspectrogram.onnx
ATHENA_WAKE_EMBEDDING_MODEL=/path/to/embedding_model.onnx
ATHENA_WAKE_THRESHOLD=0.98
ATHENA_WAKE_CONSECUTIVE=1
ATHENA_WAKE_COOLDOWN=2
ATHENA_SILENCE_END=2
ATHENA_COMMAND_WAIT=5
